# Copy to .env (never commit .env), then: docker compose up --build
PROVIDER=anthropic              # openai | anthropic | ollama   (exactly one is used; there is NO fallback to another)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5   # the model behind every reported result
OLLAMA_BASE_URL=http://host.docker.internal:11434   # Ollama on the host, seen from the container
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=32768            # measured prompts reach ~15k tokens; a smaller context would truncate them silently
LLM_TIMEOUT_S=60                # a local model on CPU needs more (e.g. 300)
LLM_MAX_OUTPUT_TOKENS=1000
# Optional: INDEX_DIR=idx  APP_HOST=127.0.0.1  APP_PORT=8000  TRACE_DIR=out/trace  LOG_LEVEL=INFO
# Not configurable on purpose: embedding model, tokenizer, chunking, evidence count (they are fixed by the shipped index manifest).
