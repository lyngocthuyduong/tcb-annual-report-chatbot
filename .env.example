# Copy to .env (never commit .env). Online mode = docker compose up --build
PROVIDER=openai                 # openai | anthropic | ollama   (exactly one is used; there is NO fallback to another)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_BASE_URL=http://host.docker.internal:11434   # host Ollama. Offline profile overrides this to http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192             # prompts are ~5k tokens; Ollama's default context would truncate them
LLM_TIMEOUT_S=60                # local CPU models need more (offline profile sets 300)
LLM_MAX_OUTPUT_TOKENS=1000
# Optional: INDEX_DIR=idx  APP_HOST=127.0.0.1  APP_PORT=8000  TRACE_DIR=out/trace  LOG_LEVEL=INFO
# Not configurable on purpose: embedding model, reranker, tokenizer, chunking (they are fixed by the shipped index manifest).
